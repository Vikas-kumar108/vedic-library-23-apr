{
  "name": "dharma-monorepo",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "schema": "packages/data-access/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "pnpm --filter @dharma/web-portal dev",
    "build": "pnpm db:generate && pnpm -r build",
    "lint": "pnpm -r lint",
    "sync": "pnpm --filter @dharma/web-portal run sync",
    "db:push": "pnpm --filter @dharma/data-access db:push",
    "db:generate": "pnpm --filter @dharma/data-access db:generate",
    "prisma": "prisma",
    "postinstall": "pnpm db:generate"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1036.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@supabase/supabase-js": "^2.104.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.21.0",
    "ws": "^8.20.0"
  }
}