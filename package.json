{
  "name": "dharma-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @dharma/web-portal dev",
    "build": "pnpm db:generate && pnpm -r build",
    "lint": "pnpm -r lint",
    "sync": "pnpm --filter @dharma/web-portal run sync",
    "db:push": "pnpm --filter @dharma/data-access db:push",
    "db:generate": "pnpm --filter @dharma/data-access db:generate"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  }
}
