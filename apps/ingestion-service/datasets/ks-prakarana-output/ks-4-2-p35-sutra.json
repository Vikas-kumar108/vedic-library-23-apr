  "sutras": [
    {
      "number": "4.2.16",
      "text": "सेच्तिओन्(प्रकरण)३५ कनिष्ठा तु मातृवत्सःपत्नीं पश्येत् ॥ ४.२.१६ ॥"
    },
    {
      "number": "4.2.17",
      "text": "ज्ञातिदायं अपि तस्या अःविदितं नोपयुञ्जीत ॥ ४.२.१७ ॥"
    },
    {
      "number": "4.2.18",
      "text": "आत्मवृत्तान्तांस्तदधिष्ठितान्कुर्यात् ॥ ४.२.१८ ॥"
    },
    {
      "number": "4.2.19",
      "text": "अनुज्ञाता पतिं अधिशयीत ॥ ४.२.१९ ॥"
    },
    {
      "number": "4.2.20",
      "text": "न वा तस्या वचनं अन्यस्याः कथयेत् ॥ ४.२.२० ॥"
    },
    {
      "number": "4.2.21",
      "text": "तदपत्यानि स्वेभ्योऽधिकानि पश्येत्..४.२.२२ रहसि पतिं अधिकं उपचरेत् ॥ ४.२.२१ ॥"
    },
    {
      "number": "4.2.23",
      "text": "आत्मनश्च सपत्नीविकारजं दुःखं नाचक्षीत ॥ ४.२.२३ ॥"
    },
    {
      "number": "4.2.24",
      "text": "पत्युष्च सःविशेषकं गूढं मानं लिप्सेत् ॥ ४.२.२४ ॥"
    },
    {
      "number": "4.2.25",
      "text": "अनेन खलु पथ्यदानेन जीवामीति ब्रूयात् ॥ ४.२.२५ ॥"
    },
    {
      "number": "4.2.26",
      "text": "तत्तु श्लाघया रागेण वा बाहिर्नाचक्षीत ॥ ४.२.२६ ॥"
    },
    {
      "number": "4.2.27",
      "text": "भिन्नरहस्या हि भर्तुरवज्ञां लभते ॥ ४.२.२७ ॥"
    },
    {
      "number": "4.2.28",
      "text": "ज्येष्ठाभयाच्च निगूढसंमानार्थिनी स्यादिति गोनर्दीयः ॥ ४.२.२८ ॥"
    },
    {
      "number": "4.2.29",
      "text": "दुरःभागं अनःअपत्यां च ज्येष्ठां अनुकम्पेत नायकेन चानुकम्पयेत् ॥ ४.२.२९ ॥"
    },
    {
      "number": "4.2.30",
      "text": "प्रसह्य त्वेनां एकचारिणीवृत्तं अनुतिष्ठेत् ॥ ४.२.३० ॥"
    },
    {
      "number": "4.2.30",
      "text": "चिति कनिष्ठावृत्तम्((१२२)) ॥ ४.२.३० ॥"
    }
  ]
}