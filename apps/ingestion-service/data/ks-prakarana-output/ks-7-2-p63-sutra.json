  "sutras": [
    {
      "number": "7.2.25",
      "text": "एवं वृक्षजानां जन्तूनां शूकैरुपहितं लिङ्गं दशरात्रं तैलेन मृदितं पुनरुपतृंहितं पुनः प्रमृदितं इति जातशोफं खट्वायां अधोमुखस्तदन्तरे लम्बयेत् ॥ ७.२.२५ ॥"
    },
    {
      "number": "7.2.26",
      "text": "तत्र शीतैः कषायैः कृतवेदनाःनिग्रहं सोपक्रमेण निष्पादयेत् ॥ ७.२.२६ ॥"
    },
    {
      "number": "7.2.27",
      "text": "स यावज्जीवं शूकजो नाम शोफो विटानाम् ॥ ७.२.२७ ॥"
    },
    {
      "number": "7.2.28",
      "text": "अश्वगन्धाशबरकन्दजलशूकबृहतीफलमहीषनवनीतहस्तिकर्णवज्रवल्लीरसैरेकैकेन परिमर्दनं मासिकं वर्धनम् ॥ ७.२.२८ ॥"
    },
    {
      "number": "7.2.29",
      "text": "एतैरेव कषायैः पक्वेन तैलेन परिमर्दनं षाण्मास्यम् ॥ ७.२.२९ ॥"
    },
    {
      "number": "7.2.30",
      "text": "दाडिमत्रापुषबीजानि बालुका बृहतीफलरसश्चेति मिद्वग्निना पक्वेन तैलेन परिमर्दनं परिषेको वा ॥ ७.२.३० ॥"
    },
    {
      "number": "7.2.31",
      "text": "तांस्तांश्च योगानाप्तेभ्यो बुध्येत ॥ ७.२.३१ ॥"
    }
  ]
}