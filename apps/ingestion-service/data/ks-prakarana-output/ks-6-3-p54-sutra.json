  "sutras": [
    {
      "number": "6.3.27",
      "text": "सेच्तिओन्(प्रकरण)५४विःरक्तं च नित्यं एव प्रकृतिविक्रियातो विद्यान्मुखवर्णाच्च ॥ ६.३.२७ ॥"
    },
    {
      "number": "6.3.28",
      "text": "ऊनं अतिरिक्तं वा ददाति ॥ ६.३.२८ ॥"
    },
    {
      "number": "6.3.29",
      "text": "प्रतिलोमैः सम्बध्यते ॥ ६.३.२९ ॥"
    },
    {
      "number": "6.3.30",
      "text": "व्यपदिश्यान्यत्करोति ॥ ६.३.३० ॥"
    },
    {
      "number": "6.3.31",
      "text": "उचितं आच्छिनत्ति ॥ ६.३.३१ ॥"
    },
    {
      "number": "6.3.32",
      "text": "प्रतिज्ञातं विस्मरति. अन्यथा वा योजयति ॥ ६.३.३२ ॥"
    },
    {
      "number": "6.3.33",
      "text": "स्वःपक्षैः संज्ञया भाषते ॥ ६.३.३३ ॥"
    },
    {
      "number": "6.3.34",
      "text": "मित्रकार्यं अपदिश्यान्यत्र शेते ॥ ६.३.३४ ॥"
    },
    {
      "number": "6.3.35",
      "text": "पूर्वसंसृष्टायाश्च परिजनेन मिथः कथयति ॥ ६.३.३५ ॥"
    },
    {
      "number": "6.3.36",
      "text": "तस्य सारद्रव्याणि प्रागवबोधादन्यापदेशेन हस्ते कुर्वीत ॥ ६.३.३६ ॥"
    },
    {
      "number": "6.3.37",
      "text": "तानि चास्या हस्तादुत्तमर्णः प्रसह्य गृह्णीयात् ॥ ६.३.३७ ॥"
    },
    {
      "number": "6.3.38",
      "text": "विवदमानेन सह धर्मस्थेषु((१६९)) व्यवहरेद् ॥ ६.३.३८ ॥"
    }
  ]
}