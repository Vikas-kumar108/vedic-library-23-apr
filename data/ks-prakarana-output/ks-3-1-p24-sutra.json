  "sutras": [
    {
      "number": "3.1.20",
      "text": "सेच्तिओन्(प्रकरण)२४ भवन्ति चात्र श्लोकाः ॥ ३.१.२० ॥"
    },
    {
      "number": "3.1.20",
      "text": "व्समस्याद्याः सहक्रीडा विवाहाः सङ्गतानि च. समानैरेव कर्याणि नोत्तमैर्नापि वाधमैर्. ॥ ३.१.२० ॥"
    },
    {
      "number": "3.1.21",
      "text": "व्कन्यां गृहीत्वा वर्तेत प्रेष्यवद्यत्र नायकः. तं विद्यादुच्चसंबन्धं परित्यक्तं मनस्विभिः. ॥ ३.१.२१ ॥"
    },
    {
      "number": "3.1.22",
      "text": "व्स्वामिवद्विचरेद्यत्र बान्धवैः स्वैः पुरसःकृतः. अःश्लाघ्यो हीनसंबन्धः सोऽपि सद्भिर्विनिन्द्यते. ॥ ३.१.२२ ॥"
    },
    {
      "number": "3.1.23",
      "text": "व्परस्परसुखास्वादा क्रीडा यत्र प्रयुज्यते. विशेषयन्ती चान्योन्यं संबन्धः स विधीयते. ॥ ३.१.२३ ॥"
    },
    {
      "number": "3.1.24",
      "text": "व्कृत्वापि चोच्चसंबन्धं पश्चाज्ज्ञातिषु संनमेत्. न त्वेव हीनसंबन्धं कुर्यात्सद्भिर्विनिन्दितम्((७२)). ॥ ३.१.२४ ॥"
    }
  ],
  "colophon": {
    "text": "इति श्रीवात्स्यायनीये कामसूत्रे सांप्रयोगिके तृतीयेऽधिकरणे वरणविधानं संबन्धनिश्चयश्च प्रथमोऽध्यायः ॥ ३.१ ॥"
  }
}