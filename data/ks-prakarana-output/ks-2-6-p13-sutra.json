  "sutras": [
    {
      "number": "2.6.1",
      "text": "रागकाले विशालयन्त्येव जघनं मृगी संविशेदुच्चरते ॥ २.६.१ ॥"
    },
    {
      "number": "2.6.2",
      "text": "अवह्रासयन्तीव हस्तिनी नीचरते ॥ २.६.२ ॥"
    },
    {
      "number": "2.6.3",
      "text": "न्याय्यो यत्र योगस्तत्र समपृष्ठम् ॥ २.६.३ ॥"
    },
    {
      "number": "2.6.4",
      "text": "आभ्यां बडवा व्याख्याता ॥ २.६.४ ॥"
    },
    {
      "number": "2.6.5",
      "text": "तत्र जघनेन नायकं प्रतिगृह्णीयात् ॥ २.६.५ ॥"
    },
    {
      "number": "2.6.6",
      "text": "अपद्रव्याणि च सःविशेषं नीचरते ॥ २.६.६ ॥"
    },
    {
      "number": "2.6.7",
      "text": "[१] उत्फुल्लकं [२] विजृम्भितकं [३] इन्द्राणिकं चेति त्रितयं मृग्याः प्रायेण ॥ २.६.७ ॥"
    },
    {
      "number": "2.6.8",
      "text": "शिरो विनिपात्योर्ध्वं जघनं [१] उत्फुल्लकम् ॥ २.६.८ ॥"
    },
    {
      "number": "2.6.9",
      "text": "तत्रापसारं दद्यात् ॥ २.६.९ ॥"
    },
    {
      "number": "2.6.10",
      "text": "अःनीचे सक्थिनी((१९)) तिर्यगवसज्य प्रतीछेदिति [२] विजृम्भितकम् ॥ २.६.१० ॥"
    },
    {
      "number": "2.6.11",
      "text": "पार्श्वयोः समं ऊरू विन्यस्य पार्श्वयोर्जानुनी निदध्यादित्यभ्यासयोगाद्[३] इन्द्राणी ॥ २.६.११ ॥"
    },
    {
      "number": "2.6.12",
      "text": "तयोच्चतररतस्यापि परिग्रहः ॥ २.६.१२ ॥"
    },
    {
      "number": "2.6.13",
      "text": "संपुटेन प्रतिग्रहो नीचरते ॥ २.६.१३ ॥"
    },
    {
      "number": "2.6.14",
      "text": "एतेन नीचतररतेऽपि हस्तिन्याः ॥ २.६.१४ ॥"
    },
    {
      "number": "2.6.15",
      "text": "[१] संपुटकं [२] पीडितकं [३] वेष्टितकं [४] बाडवकं इति ॥ २.६.१५ ॥"
    },
    {
      "number": "2.6.16",
      "text": "ऋजुप्रसारितावुभावप्युभयोः चरनाविति [१] संपुटः ॥ २.६.१६ ॥"
    },
    {
      "number": "2.6.17",
      "text": "स द्विविधः ण् पार्श्वसंपुट उत्तानसंपुटाश्च. तथा कर्मयोगात् ॥ २.६.१७ ॥"
    },
    {
      "number": "2.6.18",
      "text": "पार्श्वेण तु शयानो दक्षिणेन नारीं अधिशयीतेति सार्वत्रिकं एतत् ॥ २.६.१८ ॥"
    },
    {
      "number": "2.6.19",
      "text": "संपुटकप्रयुक्तयन्त्रेणैव दृढं ऊरू पीडयेदिति [२] पीडितकम् ॥ २.६.१९ ॥"
    },
    {
      "number": "2.6.20",
      "text": "ऊरू व्यत्यस्येदिति [३] वेष्टितकम् ॥ २.६.२० ॥"
    },
    {
      "number": "2.6.21",
      "text": "बडवेव निष्ठुरं अवगृह्णीयादिति [४] बाडवकं आभ्यासिकम् ॥ २.६.२१ ॥"
    },
    {
      "number": "2.6.22",
      "text": "तदान्ध्रीषु प्रायेण. इति संवेशनप्रकारा बाभ्रवीयाः ॥ २.६.२२ ॥"
    },
    {
      "number": "2.6.23",
      "text": "सौवर्णनाभास्तु ॥ २.६.२३ ॥"
    },
    {
      "number": "2.6.24",
      "text": "उभावप्यूरू ऊर्ध्वाविति तद्भुग्नकम्((२०)) ॥ २.६.२४ ॥"
    },
    {
      "number": "2.6.25",
      "text": "चरणावूर्ध्वं नायकोऽस्या धारयेदिति जृम्भितकम् ॥ २.६.२५ ॥"
    },
    {
      "number": "2.6.26",
      "text": "तत्कुञ्चितावुत्पीडितकम् ॥ २.६.२६ ॥"
    },
    {
      "number": "2.6.27",
      "text": "तदेकस्मिन्प्रसारितेऽर्धपीडितकम् ॥ २.६.२७ ॥"
    },
    {
      "number": "2.6.28",
      "text": "नायकस्यांस एको द्वितीयकः प्रसारित इति पुनः पुनर्व्यत्यासेन वेणुदारितकम् ॥ २.६.२८ ॥"
    },
    {
      "number": "2.6.29",
      "text": "एकः शिरस उपरि गच्छेद्द्वितीयः प्रसारित इति शूलचितकं आभ्यासिकम् ॥ २.६.२९ ॥"
    },
    {
      "number": "2.6.30",
      "text": "संकुचितौ स्वस्तिदेशे निदध्यादिति कार्कटकम् ॥ २.६.३० ॥"
    },
    {
      "number": "2.6.31",
      "text": "ऊर्ध्वावूरू व्यत्यस्येदिति पीडितकम् ॥ २.६.३१ ॥"
    },
    {
      "number": "2.6.32",
      "text": "जङ्घाव्यत्यासेन पद्मासनवत् ॥ २.६.३२ ॥"
    },
    {
      "number": "2.6.33",
      "text": "पृष्ठं परिष्वजमानायाः पराङ्मुखेण परावृत्तकं आभ्यासिकम्..२.६.३४ जले च संविष्टोपविष्टस्थितात्मकांश्चित्रान्योगानुपलक्षयेत्. तथा सुःकरत्वादिति सुवर्णनाभः ॥ २.६.३३ ॥"
    },
    {
      "number": "2.6.35",
      "text": "वार्तं तु तत्. शिष्टैरपस्मृतत्वादिति वात्स्यायनः ॥ २.६.३५ ॥"
    }
  ]
}