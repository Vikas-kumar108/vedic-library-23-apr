  "sutras": [
    {
      "number": "6.2.1",
      "text": "संयुक्ता नायकेन तद्रण्जनार्थं एकचारिणीवृत्तं अनुतिष्ठेत्((१६६)) ॥ ६.२.१ ॥"
    },
    {
      "number": "6.2.2",
      "text": "रञ्जयेन्न तु सज्जेत सक्तवच्च विचेष्टेतेति संक्षेपोक्तिः ॥ ६.२.२ ॥"
    },
    {
      "number": "6.2.3",
      "text": "मातरि च क्रूरशीलायां अर्थपरायां चायत्ता स्यात् ॥ ६.२.३ ॥"
    },
    {
      "number": "6.2.4",
      "text": "तदःभावे मातृकायाम् ॥ ६.२.४ ॥"
    },
    {
      "number": "6.2.5",
      "text": "सा तु गम्येन नातिप्रीयेत ॥ ६.२.५ ॥"
    },
    {
      "number": "6.2.6",
      "text": "प्रसह्य च दुहितरं आनयेत् ॥ ६.२.६ ॥"
    },
    {
      "number": "6.2.7",
      "text": "तत्र तु नायिकायाः संततं अःरतिर्निर्वेदो व्रीडां भयं च ॥ ६.२.७ ॥"
    },
    {
      "number": "6.2.8",
      "text": "न त्वेव शासनातिवृत्तिः ॥ ६.२.८ ॥"
    },
    {
      "number": "6.2.9",
      "text": "व्याधिं चैकं अःनिमित्तं अःजुगुप्सितं अःचक्षुर्ग्राह्यं अःनित्यं च ख्यापयेत् ॥ ६.२.९ ॥"
    },
    {
      "number": "6.2.10",
      "text": "सति कारणे तदपदेशं च नायकानःअभिगमनम् ॥ ६.२.१० ॥"
    },
    {
      "number": "6.2.11",
      "text": "निरःमाल्यस्य तु नायिका चेटिकां प्रेषयेत्ताम्बूलस्य च ॥ ६.२.११ ॥"
    },
    {
      "number": "6.2.12",
      "text": "व्यवाये तदुपचारेषु विस्मयः ॥ ६.२.१२ ॥"
    },
    {
      "number": "6.2.13",
      "text": "चतुःषष्ट्यां शिष्यत्वम् ॥ ६.२.१३ ॥"
    },
    {
      "number": "6.2.14",
      "text": "तदुपदिष्टानां च योगानां आभीक्ष्ण्येनानुयोगः ॥ ६.२.१४ ॥"
    },
    {
      "number": "6.2.15",
      "text": "तत्सात्म्याद्रहसि वृत्तिः ॥ ६.२.१५ ॥"
    },
    {
      "number": "6.2.16",
      "text": "मनोरथानां आख्यानम् ॥ ६.२.१६ ॥"
    },
    {
      "number": "6.2.17",
      "text": "गुह्यानां वैकृतप्रच्छादनम् ॥ ६.२.१७ ॥"
    },
    {
      "number": "6.2.18",
      "text": "शयने परावृत्तस्यानुपेक्षणम् ॥ ६.२.१८ ॥"
    },
    {
      "number": "6.2.19",
      "text": "आनुलोम्यं गुह्यस्पर्शने ॥ ६.२.१९ ॥"
    },
    {
      "number": "6.2.20",
      "text": "सुप्तस्य चुम्बनं आलिङ्गनं च ॥ ६.२.२० ॥"
    },
    {
      "number": "6.2.21",
      "text": "प्रेक्षणं अन्यमनस्कस्य. राजमार्गे च प्रासादस्थायास्तत्र विदिताया व्रीडा शाठ्यनाशः ॥ ६.२.२१ ॥"
    },
    {
      "number": "6.2.22",
      "text": "तद्द्वेष्ये द्वेष्यता. तत्प्रिये प्रियता. तद्रम्य रतिः. तं अनु हर्षशोकौ. स्त्रीषु जिज्ञासा. कोपश्चाःदीर्गः ॥ ६.२.२२ ॥"
    },
    {
      "number": "6.2.23",
      "text": "स्वकृतेष्वपि नखदशनचिह्नेष्वन्याशङ्का ॥ ६.२.२३ ॥"
    },
    {
      "number": "6.2.24",
      "text": "अनुरगस्याःवचनम् ॥ ६.२.२४ ॥"
    },
    {
      "number": "6.2.25",
      "text": "आकारतस्तु दर्शयेत् ॥ ६.२.२५ ॥"
    },
    {
      "number": "6.2.26",
      "text": "मदस्वप्नव्याधिषु तु निर्वचनम् ॥ ६.२.२६ ॥"
    },
    {
      "number": "6.2.27",
      "text": "श्लाघ्यानां नायककर्मणां च ॥ ६.२.२७ ॥"
    },
    {
      "number": "6.2.28",
      "text": "तस्मिन्ब्रुवाणे वाक्यार्थग्रहणम्. तदवधार्य प्रशंसाविषये भाषणम्. तद्वाक्यस्य चोत्तरेण योजनम्. भक्तिमांश्चेत् ॥ ६.२.२८ ॥"
    },
    {
      "number": "6.2.29",
      "text": "कथास्वनुवृत्तिरन्यत्र सःपत्न्याः ॥ ६.२.२९ ॥"
    },
    {
      "number": "6.2.30",
      "text": "निःश्वासे जृम्भते स्खलिते पतिते वा तस्य चार्तिं आशंसीत ॥ ६.२.३० ॥"
    },
    {
      "number": "6.2.31",
      "text": "क्षुतव्याहृतविस्मितेषु जीवेत्युदाहरणम् ॥ ६.२.३१ ॥"
    },
    {
      "number": "6.2.32",
      "text": "दौर्मनस्ये व्याधिदौर्हृदापदेशः ॥ ६.२.३२ ॥"
    },
    {
      "number": "6.2.33",
      "text": "गुणतः परस्याःकीर्तनम् ॥ ६.२.३३ ॥"
    },
    {
      "number": "6.2.34",
      "text": "न निन्दा समानदोषस्य ॥ ६.२.३४ ॥"
    },
    {
      "number": "6.2.35",
      "text": "दत्तस्य धारणम् ॥ ६.२.३५ ॥"
    },
    {
      "number": "6.2.36",
      "text": "वृथापराधे तद्व्यसने वालङ्कारस्याःग्रहणं अःभोजनं च ॥ ६.२.३६ ॥"
    },
    {
      "number": "6.2.37",
      "text": "तद्युक्ताश्च विलापाः ॥ ६.२.३७ ॥"
    },
    {
      "number": "6.2.38",
      "text": "तेन सह देशमोक्षं रोचयेत्राजनि निष्क्रयं च ॥ ६.२.३८ ॥"
    },
    {
      "number": "6.2.39",
      "text": "सामर्थ्यं आयुष्यस्तदवाप्तौ ॥ ६.२.३९ ॥"
    },
    {
      "number": "6.2.40",
      "text": "तस्यार्थाधिगमेऽभिप्रेतसिद्धौ शरीरोपचये वा पूर्वसंभाषित इष्टदेवतोपहारः ॥ ६.२.४० ॥"
    },
    {
      "number": "6.2.41",
      "text": "नित्यं अलङ्कारयोगः. परिमितोऽभ्यवहारः. ॥ ६.२.४१ ॥"
    },
    {
      "number": "6.2.42",
      "text": "गीते च नामगोत्रयोर्ग्रहणम्. ग्लान्यां उरसि ललाटे च करं कुर्वीत. तत्सुखं उपलभ्य निद्रालाभः ॥ ६.२.४२ ॥"
    },
    {
      "number": "6.2.43",
      "text": "औत्सङ्गे चास्योपवेशनं स्वपनं च. गमनं वियोगे ॥ ६.२.४३ ॥"
    },
    {
      "number": "6.2.44",
      "text": "तस्मात्पुत्रार्थिनी स्यात्. आयुषो नाधिक्यं इच्छेत् ॥ ६.२.४४ ॥"
    },
    {
      "number": "6.2.45",
      "text": "एतस्याःविज्ञातं अर्थं रहसि न ब्रूयात् ॥ ६.२.४५ ॥"
    },
    {
      "number": "6.2.46",
      "text": "व्रतं उपवासं चास्य निर्वर्तयेत्मयि दोष इति. अःशक्ये स्वयं अपि तद्रूपा स्यात् ॥ ६.२.४६ ॥"
    },
    {
      "number": "6.2.47",
      "text": "विवादे तेनाप्यःशक्यं इत्यर्थनिर्देशः ॥ ६.२.४७ ॥"
    },
    {
      "number": "6.2.48",
      "text": "तदीयं आत्मीयं वा स्वयं अःविशेषेण पश्येत् ॥ ६.२.४८ ॥"
    },
    {
      "number": "6.2.49",
      "text": "तेन विना गोष्ठ्यादीनां अःगमनं इति ॥ ६.२.४९ ॥"
    },
    {
      "number": "6.2.50",
      "text": "निरःमाल्यधारणे श्लाघा उच्छिष्टभोजने च ॥ ६.२.५० ॥"
    },
    {
      "number": "6.2.51",
      "text": "कुलशीलशिल्पजातिविद्यावर्णवित्तदेशमित्रगुणवयोमाधुर्यपूजा ॥ ६.२.५१ ॥"
    },
    {
      "number": "6.2.52",
      "text": "गीतादिषु चोदनं अभिज्ञस्य ॥ ६.२.५२ ॥"
    },
    {
      "number": "6.2.53",
      "text": "भयशीतोष्णवर्षाण्यनःअपेक्ष्य तदभिगमनम् ॥ ६.२.५३ ॥"
    },
    {
      "number": "6.2.54",
      "text": "स एव च मे स्यादित्यौर्ध्वदेहिकेषु वचनम् ॥ ६.२.५४ ॥"
    },
    {
      "number": "6.2.55",
      "text": "तदिष्टरसभावशीलानुवर्तनम् ॥ ६.२.५५ ॥"
    },
    {
      "number": "6.2.56",
      "text": "मूलकर्माभिशङ्का ॥ ६.२.५६ ॥"
    },
    {
      "number": "6.2.57",
      "text": "तदभिगमने च जनन्या सह नित्यो विवादः ॥ ६.२.५७ ॥"
    },
    {
      "number": "6.2.58",
      "text": "बलात्कारेण च यद्यन्यत्र तया नीयेत तदा विषं अनःअशनं शस्त्रं रज्जुं इति कामयेत ॥ ६.२.५८ ॥"
    },
    {
      "number": "6.2.59",
      "text": "प्रत्यायनं च प्रणिधिभिर्नायकस्य. स्वयं वात्मनो वृत्तिग्रहणम् ॥ ६.२.५९ ॥"
    },
    {
      "number": "6.2.60",
      "text": "न त्वेवार्थेषु विवादः ॥ ६.२.६० ॥"
    },
    {
      "number": "6.2.61",
      "text": "मात्रा विना किं चिन्न चेष्टेत ॥ ६.२.६१ ॥"
    },
    {
      "number": "6.2.62",
      "text": "प्रवासे शीघ्रागमनाय शापदानम् ॥ ६.२.६२ ॥"
    },
    {
      "number": "6.2.63",
      "text": "प्रोषिते मृजानियमश्चालङ्कारस्य प्रतिषेधः. मङ्गलं त्वपेक्ष्यम्. एकं शङ्खवलयं वा धारयेत् ॥ ६.२.६३ ॥"
    },
    {
      "number": "6.2.64",
      "text": "स्मरणं अतीतानाम्. गमनं ईक्षणिकोपश्रुतीनाम्. नक्षत्रचन्द्रसूर्यताराभ्यः स्पृहणम् ॥ ६.२.६४ ॥"
    },
    {
      "number": "6.2.65",
      "text": "इष्टस्वप्नप्रदर्शने तत्सङ्गमो ममास्त्विति वचनम् ॥ ६.२.६५ ॥"
    },
    {
      "number": "6.2.66",
      "text": "उद्वेगोऽनःइष्टे सान्तिकर्म च ॥ ६.२.६६ ॥"
    },
    {
      "number": "6.2.67",
      "text": "प्रत्यागते कामपूजा ॥ ६.२.६७ ॥"
    },
    {
      "number": "6.2.68",
      "text": "देवतोपहाराणां करणम् ॥ ६.२.६८ ॥"
    },
    {
      "number": "6.2.69",
      "text": "सखीभिः पूर्णपात्रस्याहरणम् ॥ ६.२.६९ ॥"
    },
    {
      "number": "6.2.70",
      "text": "वायसपूजा च ॥ ६.२.७० ॥"
    },
    {
      "number": "6.2.71",
      "text": "प्रथमसमागमानःअन्तरं चैतदेव वायसपूजावर्जम् ॥ ६.२.७१ ॥"
    },
    {
      "number": "6.2.72",
      "text": "सक्तस्य चानुमरणं ब्रूयात् ॥ ६.२.७२ ॥"
    },
    {
      "number": "6.2.73",
      "text": "निसृष्टभावः समानवृत्तिः प्रयोजनकारी निरःआशङ्को निरःअपेक्षोऽर्थेष्विति सक्तलक्षणानि ॥ ६.२.७३ ॥"
    },
    {
      "number": "6.2.74",
      "text": "तदेतन्निदर्शनार्थं दत्तकशासनादुक्तम्. अनःउक्तं च लोकतः शीलयेत्पुरुषप्रकृतितश्च ॥ ६.२.७४ ॥"
    },
    {
      "number": "6.2.75",
      "text": "भवतश्चात्र श्लोकौ ॥ ६.२.७५ ॥"
    },
    {
      "number": "6.2.75",
      "text": "व्सूक्ष्मत्वादतिःलोभाच्च प्रकृत्याज्ञानतस्तथा. कामलक्ष्म तु दुरःजानं स्त्रीणां तद्भावितैरपि. ॥ ६.२.७५ ॥"
    },
    {
      "number": "6.2.76",
      "text": "व्कामयन्ते विरज्यन्ते रञ्जयन्ति त्यजन्ति च. कर्षयन्त्योऽपि सर्वार्थाञ् ज्ञायन्ते नैव योषितः((१६७)). ॥ ६.२.७६ ॥"
    }
  ],
  "colophon": {
    "text": "चिति श्री वात्स्यायनीये कामसूत्रे वैशिके षष्ठेऽधिकरणे कान्तानुवृत्तं द्वितीयोऽध्यायः ॥ ६.२ ॥"
  }
}