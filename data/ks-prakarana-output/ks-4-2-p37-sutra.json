  "sutras": [
    {
      "number": "4.2.45",
      "text": "सेच्तिओन्(प्रकरण)३७ दुर्भगा तु सापत्नकपीडिता या तासां अधिकं इव पत्यावुपचरेत्तां आश्रयेत्. प्रकाश्यानि च कलाविज्ञानानि दर्शयेत्. दौर्भाग्याद्रहस्यानां अःभावः ॥ ४.२.४५ ॥"
    },
    {
      "number": "4.2.46",
      "text": "नायकापत्यानां धात्रेयिकानि कुर्यात् ॥ ४.२.४६ ॥"
    },
    {
      "number": "4.2.47",
      "text": "तन्मित्राणि चोपगृह्य तैर्भक्तिं आत्मनः प्रकाशयेत् ॥ ४.२.४७ ॥"
    },
    {
      "number": "4.2.48",
      "text": "धर्मकृत्येषु च पुरश्चारिणी स्याद्व्रतोपवासयोश्च ॥ ४.२.४८ ॥"
    },
    {
      "number": "4.2.49",
      "text": "परिजने दाक्षिण्यम्. न चाधिकं आत्मानं पश्येत् ॥ ४.२.४९ ॥"
    },
    {
      "number": "4.2.50",
      "text": "शयने तत्सात्म्येनात्मनोऽनुरागप्रत्यानयनम् ॥ ४.२.५० ॥"
    },
    {
      "number": "4.2.51",
      "text": "न चोपालभेत वामतां च न दर्शयेत् ॥ ४.२.५१ ॥"
    },
    {
      "number": "4.2.52",
      "text": "यया च कलहितः स्यात्कामं तां आवर्तयेत् ॥ ४.२.५२ ॥"
    },
    {
      "number": "4.2.53",
      "text": "यां च प्रच्छन्नां कामयेत्तां अनेन सह संगमयेद्गोपयेच्च ॥ ४.२.५३ ॥"
    },
    {
      "number": "4.2.54",
      "text": "यथा च पतिव्रतात्वं अःशाठ्यं नायको मन्येत तथा प्रतिविदध्यात् ॥ ४.२.५४ ॥"
    },
    {
      "number": "4.2.54",
      "text": "चिति दुर्भगावृत्तम्((१२५)) ॥ ४.२.५४ ॥"
    }
  ]
}