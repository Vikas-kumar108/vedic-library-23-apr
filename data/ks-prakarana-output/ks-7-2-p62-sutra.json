  "sutras": [
    {
      "number": "7.2.1",
      "text": "चण्डवेगां रञ्जयितुं अःशक्नुवन्योगानाचरेत् ॥ ७.२.१ ॥"
    },
    {
      "number": "7.2.2",
      "text": "रागस्योपक्रमे संबाधस्य करेणोपमर्दनं तस्या रसप्राप्तिकाले च रतयोजनं इति रागप्रत्यानयनम् ॥ ७.२.२ ॥"
    },
    {
      "number": "7.2.3",
      "text": "औपरिष्टकं मन्दवेगस्य गतवयसो व्यायतस्य रतश्रान्तस्य च रागप्रत्यानयनम् ॥ ७.२.३ ॥"
    },
    {
      "number": "7.2.4",
      "text": "अपद्रव्याणि वा योजयेत् ॥ ७.२.४ ॥"
    },
    {
      "number": "7.2.5",
      "text": "तानि सुवर्णरजतताम्रकालायसगजदन्तगवलद्रव्यमयाणि ॥ ७.२.५ ॥"
    },
    {
      "number": "7.2.6",
      "text": "त्रापुषाणि सैसकानि च मृदूनि शीतवीर्याणि कर्मणि च धृष्णूनि भवन्तीति बाभ्रवीया योगाः ॥ ७.२.६ ॥"
    },
    {
      "number": "7.2.7",
      "text": "दारुमयानि साम्यतश्चेति वात्स्यायनः ॥ ७.२.७ ॥"
    },
    {
      "number": "7.2.8",
      "text": "लिङ्गप्रमाणान्तरं बिन्दुभिः कर्कशपर्यन्तं बहुलं स्यात् ॥ ७.२.८ ॥"
    },
    {
      "number": "7.2.9",
      "text": "एते एव द्वे संघाटी ॥ ७.२.९ ॥"
    },
    {
      "number": "7.2.10",
      "text": "त्रिप्रभृति यावत्प्रमाणं वा चूडकः ॥ ७.२.१० ॥"
    },
    {
      "number": "7.2.11",
      "text": "एकां एव लतिकां प्रमाणवशेन वेष्टयेदित्येकचूडकः ॥ ७.२.११ ॥"
    },
    {
      "number": "7.2.12",
      "text": "उभयतोःमुखच्छिद्रः स्थूलकर्कशवृषणगुटिकायुक्तः प्रमाणवशयोगी कट्यां बद्धः कञ्चुको जालकं वा ॥ ७.२.१२ ॥"
    },
    {
      "number": "7.2.13",
      "text": "तदःभावेऽलाबूनालकं वेणुश्च तैलकषायैः सुःभावितः सूत्रेण कट्यां बद्धः श्लक्ष्णा काष्ठमाला वा ग्रथिता बहुभिरामलकास्थिभिः संयुक्तेत्यपविद्धयोगाः. ॥ ७.२.१३ ॥"
    },
    {
      "number": "7.2.14",
      "text": "न त्वःविद्धस्य कस्य चिद्व्यवहृतिरस्तीति ॥ ७.२.१४ ॥"
    },
    {
      "number": "7.2.15",
      "text": "दाक्षिणात्यानां लिङ्गस्य कर्णयोरिव व्यधनं बालस्य ॥ ७.२.१५ ॥"
    },
    {
      "number": "7.2.16",
      "text": "युवा तु शस्त्रेण छेदयित्वा यावद्रुधिरस्यागमनं तावदुदके तिष्ठेत् ॥ ७.२.१६ ॥"
    },
    {
      "number": "7.2.17",
      "text": "वैशद्यार्थं च तस्यां रात्रौ निर्बन्धाद्व्यवायः ॥ ७.२.१७ ॥"
    },
    {
      "number": "7.2.18",
      "text": "ततः कषायैरेकदिनान्तरितं शोधनम् ॥ ७.२.१८ ॥"
    },
    {
      "number": "7.2.19",
      "text": "वेतसकुटजशङ्कुभिः क्रमेण वर्धमानस्य वर्धनैर्बन्धनम् ॥ ७.२.१९ ॥"
    },
    {
      "number": "7.2.20",
      "text": "यष्टीमधुकेन मधुयुक्तेन शोधनम् ॥ ७.२.२० ॥"
    },
    {
      "number": "7.2.21",
      "text": "ततः सीसकपत्त्रकर्णिकया वर्धयेत् ॥ ७.२.२१ ॥"
    },
    {
      "number": "7.2.22",
      "text": "म्रक्षयेद्भल्लातकतैलेनेति व्यधनयोगाः ॥ ७.२.२२ ॥"
    },
    {
      "number": "7.2.23",
      "text": "तस्मिन्ननःएकाकृतिविकल्पान्यपद्रव्याणि योजयेत् ॥ ७.२.२३ ॥"
    },
    {
      "number": "7.2.24",
      "text": "वृत्तं एकतो वृतां उदूखलकं कुसुमकं कण्टकितं कङ्कास्थि गजकरकं अष्टमण्डलकं भ्रमरकं शृङ्गाटकं अन्यानि वोपायतः कर्मतश्च बहुकर्मसहता चैषां मृदुकर्कशता यथासात्म्यं ॥ ७.२.२४ ॥"
    }
  ]
}