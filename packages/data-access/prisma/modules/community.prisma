model communities {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  type         community_type_enum
  description  String?
  created_at   DateTime @default(now())

  members      community_members[]
  events       community_events[]
  
  @@map("communities")
  @@schema("public")
}

model community_members {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  community_id  String   @db.Uuid
  user_id       String   @db.Uuid
  role          community_role_enum
  joined_at     DateTime @default(now())

  community communities @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user      users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("community_members")
  @@schema("public")
}

enum community_type_enum {
  village
  city
  temple
  gurukula
  online

  @@schema("public")
}

enum community_role_enum {
  member
  mentor
  leader
  organizer

  @@schema("public")
}

model community_events {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  community_id String   @db.Uuid
  type         String
  title        String
  scheduled_at DateTime

  community communities @relation(fields: [community_id], references: [id], onDelete: Cascade)

  @@map("community_events")
  @@schema("public")
}