generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  engineType      = "library"
  binaryTargets   = ["native"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [ltree, uuid_ossp(map: "uuid-ossp"), vector]
}

model Shastra {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug          String        @unique
  name          String
  structureType String        @map("structure_type")
  status        ContentStatus @default(ACTIVE)
  deletedAt     DateTime?     @map("deleted_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")
  nodes         Node[]

  @@map("shastras")
}

model Source {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String
  role        String?
  description String?
  yearApprox  Int?     @map("year_approx")
  era         String?
  createdAt   DateTime @default(now()) @map("created_at")
  updated_at  DateTime @default(now())
  texts       Text[]

  @@map("sources")
}

model Node {
  id            String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  shastraId     String                @map("shastra_id") @db.Uuid
  parentId      String?               @map("parent_id") @db.Uuid
  level         String
  slug          String?               @unique
  orderIndex    Int?                  @default(0) @map("order_index")
  canonicalRef  String?               @map("canonical_ref")
  path          Unsupported("ltree")?
  status        ContentStatus         @default(ACTIVE)
  deletedAt     DateTime?             @map("deleted_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updated_at    DateTime              @default(now())
  sensitivity   Int?                  @default(1)
  accessRules   ContentAccessRule[]
  stepInCurves  LearningCurveStep[]
  nodeProgress  UserNodeProgress[]
  bookmarks     Bookmark[]
  fromRelations NodeRelation[]        @relation("FromNode")
  toRelations   NodeRelation[]        @relation("ToNode")
  tags          NodeTag[]
  parent        Node?                 @relation("NodeToNode", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children      Node[]                @relation("NodeToNode")
  shastra       Shastra               @relation(fields: [shastraId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  texts         Text[]

  @@index([path], map: "idx_nodes_path", type: Gist)
  @@map("nodes")
}

model Text {
  id           String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nodeId       String         @map("node_id") @db.Uuid
  contentType  ContentType    @map("content_type")
  language     Language
  script       Script
  content      String
  sourceId     String?        @map("source_id") @db.Uuid
  isPrimary    Boolean?       @default(false) @map("is_primary")
  anchorWord   String?        @map("anchor_word")
  segmentOrder Int?           @map("segment_order")
  status       ContentStatus  @default(ACTIVE)
  deletedAt    DateTime?      @map("deleted_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updated_at   DateTime       @default(now())
  synonyms     Synonym[]
  embedding    TextEmbedding?
  metadata     TextMetadata?
  versions     TextVersion[]
  highlights   Highlight[]
  node         Node           @relation(fields: [nodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source       Source?        @relation(fields: [sourceId], references: [id], onUpdate: NoAction)

  @@map("texts")
}

model TextMetadata {
  textId         String          @id @map("text_id") @db.Uuid
  lifeStages     LifeStage[]     @map("life_stages")
  guidanceLevels GuidanceLevel[] @map("guidance_levels")
  isSensitive    Boolean?        @default(false) @map("is_sensitive")
  text           Text            @relation(fields: [textId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("text_metadata")
}

model Synonym {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  textId     String    @map("text_id") @db.Uuid
  word       String
  meaning    String?
  language   Language?
  orderIndex Int?      @map("order_index")
  created_at DateTime? @default(now())
  text       Text      @relation(fields: [textId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("synonyms")
}

model Tag {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug         String    @unique
  name         String?
  description  String?
  keywords     String[]
  type         String?
  parentId     String?   @map("parent_id") @db.Uuid
  sanskritName String?   @map("sanskrit_name")
  createdAt    DateTime  @default(now()) @map("created_at")
  updated_at   DateTime  @default(now())
  nodes        NodeTag[]
  parent       Tag?      @relation("TagToTag", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subtags      Tag[]     @relation("TagToTag")

  @@map("tags")
}

model NodeTag {
  nodeId String @map("node_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  node   Node   @relation(fields: [nodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([nodeId, tagId])
  @@index([nodeId], map: "idx_node_tags_node")
  @@index([tagId], map: "idx_node_tags_tag")
  @@map("node_tags")
}

model NodeRelation {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  fromNodeId   String   @map("from_node_id") @db.Uuid
  toNodeId     String   @map("to_node_id") @db.Uuid
  relationType String?  @map("relation_type")
  createdAt    DateTime @default(now()) @map("created_at")
  fromNode     Node     @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toNode       Node     @relation("ToNode", fields: [toNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fromNodeId], map: "idx_node_rel_from")
  @@index([toNodeId], map: "idx_node_rel_to")
  @@map("node_relations")
}

model SubscriptionTier {
  id                String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId             String                  @map("org_id") @db.Uuid
  name              String
  description       String?
  level             Int                     @default(1)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @default(now()) @updatedAt @map("updated_at")
  campaigns         CommunicationCampaign[]
  libraryItems      LibraryItem[]
  spiritualProfiles SpiritualProfile[]
  organization      Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("subscription_tiers")
}

model CommunicationCampaign {
  id                                                                 String                               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId                                                              String                               @map("org_id") @db.Uuid
  target_partner_id                                                  String?                              @db.Uuid
  target_org_id                                                      String?                              @db.Uuid
  title                                                              String
  content                                                            String
  type                                                               String
  status                                                             CampaignStatus?                      @default(DRAFT)
  targetTierId                                                       String?                              @map("target_tier_id") @db.Uuid
  language                                                           Language?
  scheduledAt                                                        DateTime?                            @map("scheduled_at")
  sentAt                                                             DateTime?                            @map("sent_at")
  createdAt                                                          DateTime                             @default(now()) @map("created_at")
  updatedAt                                                          DateTime                             @default(now()) @updatedAt @map("updated_at")
  CommunicationCampaignToLibraryItem                                 CommunicationCampaignToLibraryItem[]
  organization                                                       Organization                         @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations_communication_campaigns_target_org_idToorganizations Organization?                        @relation("communication_campaigns_target_org_idToorganizations", fields: [target_org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partner_organizations                                              PartnerOrganization?                 @relation(fields: [target_partner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targetTier                                                         SubscriptionTier?                    @relation(fields: [targetTierId], references: [id], onUpdate: NoAction)
  CommunicationLog                                                   CommunicationLog[]

  @@map("communication_campaigns")
}

model Organization {
  id                                                                           String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parent_id                                                                    String?                 @db.Uuid
  name                                                                         String
  type                                                                         String
  registrationNo                                                               String?                 @map("registration_no")
  pan                                                                          String?
  tan                                                                          String?
  address                                                                      String?
  createdAt                                                                    DateTime                @default(now()) @map("created_at")
  updatedAt                                                                    DateTime                @default(now()) @updatedAt @map("updated_at")
  activityLogs                                                                 ActivityLog[]
  campaigns                                                                    CommunicationCampaign[]
  communication_campaigns_communication_campaigns_target_org_idToorganizations CommunicationCampaign[] @relation("communication_campaigns_target_org_idToorganizations")
  communicationLogs                                                            CommunicationLog[]
  complianceTasks                                                              ComplianceTask[]
  contributions                                                                Contribution[]
  DonationCause                                                                DonationCause[]
  integrations                                                                 ExternalIntegration[]
  fileAssets                                                                   FileAsset[]
  financialAccounts                                                            FinancialAccount[]
  financialPeriods                                                             FinancialPeriod[]
  journalEntries                                                               JournalEntry[]
  legalDocuments                                                               LegalDocument[]
  library_items                                                                LibraryItem[]
  members                                                                      OrgMember[]
  organizations                                                                Organization?           @relation("organizationsToorganizations", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_organizations                                                          Organization[]          @relation("organizationsToorganizations")
  partnerships                                                                 Partnership[]
  physicalAssets                                                               PhysicalAsset[]
  projects                                                                     Project[]
  secure_share_links                                                           SecureShareLink[]
  subscriptionTiers                                                            SubscriptionTier[]
  supportTickets                                                               SupportTicket[]
  transactions                                                                 Transaction[]

  @@map("organizations")
}

model OrgMember {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  role           String
  baseStipend    Decimal?        @default(0) @map("base_stipend") @db.Decimal
  startDate      DateTime?       @map("start_date")
  endDate        DateTime?       @map("end_date")
  createdAt      DateTime?       @default(now()) @map("created_at")
  updatedAt      DateTime?       @default(now()) @updatedAt @map("updated_at")
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payrollRecords PayrollRecord[]

  @@map("org_members")
}

model PartnerReport {
  id            String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  partnershipId String                 @map("partnership_id") @db.Uuid
  reportType    String                 @map("report_type")
  fileId        String                 @map("file_id") @db.Uuid
  periodStart   DateTime?              @map("period_start") @db.Date
  periodEnd     DateTime?              @map("period_end") @db.Date
  submittedAt   DateTime?              @map("submitted_at")
  deletedAt     DateTime?              @map("deleted_at")
  createdAt     DateTime?              @default(now()) @map("created_at")
  updatedAt     DateTime?              @default(now()) @updatedAt @map("updated_at")
  versions      PartnerReportVersion[]
  file          FileAsset              @relation(fields: [fileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partnership   Partnership            @relation(fields: [partnershipId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("partner_reports")
}

model PartnerReportVersion {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reportId      String        @map("report_id") @db.Uuid
  fileId        String        @map("file_id") @db.Uuid
  versionNumber Int           @map("version_number")
  createdAt     DateTime?     @default(now()) @map("created_at")
  file          FileAsset     @relation(fields: [fileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  report        PartnerReport @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("partner_report_versions")
}

model PayrollRecord {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgMemberId   String          @map("org_member_id") @db.Uuid
  transactionId String?         @map("transaction_id") @db.Uuid
  periodId      String          @map("period_id") @db.Uuid
  amount        Decimal         @db.Decimal
  type          String?         @default("STIPEND")
  status        String?         @default("PENDING")
  paidAt        DateTime?       @map("paid_at")
  createdAt     DateTime?       @default(now()) @map("created_at")
  updatedAt     DateTime?       @default(now()) @updatedAt @map("updated_at")
  orgMember     OrgMember       @relation(fields: [orgMemberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  period        FinancialPeriod @relation(fields: [periodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction   Transaction?    @relation(fields: [transactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("payroll_records")
}

model PartnerOrganization {
  id                      String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                    String
  type                    PartnerType
  registrationNumber      String?                 @map("registration_number")
  pan                     String?
  tan                     String?
  contactPerson           String?                 @map("contact_person")
  email                   String?
  phone                   String?
  address                 String?
  website                 String?
  createdAt               DateTime?               @default(now()) @map("created_at")
  updatedAt               DateTime?               @default(now()) @updatedAt @map("updated_at")
  communication_campaigns CommunicationCampaign[]
  communicationLogs       CommunicationLog[]
  partnerships            Partnership[]

  @@map("partner_organizations")
}

model Partnership {
  id              String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId           String              @map("org_id") @db.Uuid
  partnerId       String              @map("partner_id") @db.Uuid
  title           String
  description     String?
  startDate       DateTime?           @map("start_date") @db.Date
  endDate         DateTime?           @map("end_date") @db.Date
  status          GrantStatus?        @default(ACTIVE)
  agreementFileId String?             @map("agreement_file_id") @db.Uuid
  createdAt       DateTime?           @default(now()) @map("created_at")
  updatedAt       DateTime?           @default(now()) @updatedAt @map("updated_at")
  grants          Grant[]
  partnerReports  PartnerReport[]
  agreementFile   FileAsset?          @relation("PartnershipAgreement", fields: [agreementFileId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_agreement_file")
  organization    Organization        @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partner         PartnerOrganization @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("partnerships")
}

model LegalDocument {
  id           String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId        String                    @map("org_id") @db.Uuid
  title        String
  category     String
  fileUrl      String                    @map("file_url")
  status       LegalDocumentStatus?      @default(ACTIVE)
  createdById  String?                   @map("created_by_id") @db.Uuid
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @default(now()) @updatedAt @map("updated_at")
  versions     DocumentVersion[]
  users        User?                     @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sharedLinks  SecureShareLinkDocument[]

  @@map("legal_documents")
}

model DocumentVersion {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  documentId    String        @map("document_id") @db.Uuid
  fileUrl       String        @map("file_url")
  versionNumber Int           @map("version_number")
  changeNote    String?       @map("change_note")
  createdById   String        @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  users         User          @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document      LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("document_versions")
}

model SecureShareLink {
  id            String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId         String                    @map("org_id") @db.Uuid
  token         String                    @unique
  purpose       String?
  expiresAt     DateTime                  @map("expires_at")
  accessCount   Int?                      @default(0) @map("access_count")
  createdAt     DateTime                  @default(now()) @map("created_at")
  documents     SecureShareLinkDocument[]
  organizations Organization              @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("secure_share_links")
}

model SecureShareLinkDocument {
  linkId      String              @map("link_id") @db.Uuid
  documentId  String              @map("document_id") @db.Uuid
  accessLevel DocumentPermission? @default(READ) @map("access_level")
  document    LegalDocument       @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  link        SecureShareLink     @relation(fields: [linkId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([linkId, documentId])
  @@map("secure_share_link_documents")
}

model FinancialAccount {
  id                   String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId                String           @map("org_id") @db.Uuid
  name                 String
  type                 String
  balance              Decimal          @default(0) @db.Decimal
  currency             String?          @default("INR")
  createdAt            DateTime?        @default(now()) @map("created_at")
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at")
  organization         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  journalLines         JournalLine[]
  ledgerSnapshots      LedgerSnapshot[]
  incomingTransactions Transaction[]    @relation("DestinationAccount")
  outgoingTransactions Transaction[]    @relation("SourceAccount")

  @@map("financial_accounts")
}

model Transaction {
  id                   String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId                String             @map("org_id") @db.Uuid
  grantId              String?            @map("grant_id") @db.Uuid
  causeId              String?            @map("cause_id") @db.Uuid
  projectId            String?            @map("project_id") @db.Uuid
  amount               Decimal            @db.Decimal
  type                 TransactionType
  date                 DateTime?          @default(now())
  sourceAccountId      String?            @map("source_account_id") @db.Uuid
  destinationAccountId String?            @map("destination_account_id") @db.Uuid
  category             String
  purpose              String
  paymentmethod        PaymentMethod
  provider             String?
  externalPaymentId    String?            @map("external_payment_id")
  isCorpus             Boolean?           @default(false) @map("is_corpus")
  gstApplicable        Boolean?           @default(false) @map("gst_applicable")
  tdsApplicable        Boolean?           @default(false) @map("tds_applicable")
  recordedById         String             @map("recorded_by_id") @db.Uuid
  approvedById         String?            @map("approved_by_id") @db.Uuid
  status               TransactionStatus? @default(PENDING)
  deletedAt            DateTime?          @map("deleted_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at")
  auditLogs            AuditLog[]
  contribution         Contribution?
  donationReceipt      DonationReceipt?
  journalEntries       JournalEntry[]
  paymentRecord        PaymentRecord?
  payrollRecords       PayrollRecord[]
  approvedBy           User?              @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cause                DonationCause?     @relation(fields: [causeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destinationAccount   FinancialAccount?  @relation("DestinationAccount", fields: [destinationAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grant                Grant?             @relation(fields: [grantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  project              Project?           @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recordedBy           User               @relation("RecordedBy", fields: [recordedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceAccount        FinancialAccount?  @relation("SourceAccount", fields: [sourceAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([causeId], map: "idx_transactions_cause")
  @@map("transactions")
}

model AuditLog {
  id            String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  table_name    String?
  record_id     String?      @db.Uuid
  transactionId String?      @map("transaction_id") @db.Uuid
  module        String?
  action        String
  performedById String       @map("performed_by_id") @db.Uuid
  oldData       Json?        @map("old_data")
  newData       Json?        @map("new_data")
  ip_address    String?
  device_info   String?
  timestamp     DateTime     @default(now())
  performedBy   User         @relation(fields: [performedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onUpdate: NoAction)

  @@map("audit_logs")
}

model FinancialPeriod {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId          String           @map("org_id") @db.Uuid
  yearLabel      String           @map("year_label")
  startDate      DateTime         @map("start_date") @db.Date
  endDate        DateTime         @map("end_date") @db.Date
  isClosed       Boolean?         @default(false) @map("is_closed")
  closedAt       DateTime?        @map("closed_at")
  createdAt      DateTime?        @default(now()) @map("created_at")
  updatedAt      DateTime?        @default(now()) @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  snapshots      LedgerSnapshot[]
  payrollRecords PayrollRecord[]

  @@map("financial_periods")
}

model LedgerSnapshot {
  id             String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  accountId      String?           @map("account_id") @db.Uuid
  periodId       String?           @map("period_id") @db.Uuid
  openingBalance Decimal?          @map("opening_balance") @db.Decimal
  closingBalance Decimal?          @map("closing_balance") @db.Decimal
  createdAt      DateTime?         @default(now()) @map("created_at")
  account        FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  period         FinancialPeriod?  @relation(fields: [periodId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([accountId, periodId], map: "ledger_snapshot_unique")
  @@map("ledger_snapshots")
}

model Grant {
  id                      String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  partnershipId           String                   @map("partnership_id") @db.Uuid
  amount                  Decimal                  @db.Decimal
  currency                String?                  @default("INR")
  purpose                 String?
  disbursementType        String?                  @map("disbursement_type")
  status                  GrantStatus?             @default(ACTIVE)
  isRestricted            Boolean?                 @default(true) @map("is_restricted")
  startDate               DateTime?                @map("start_date") @db.Date
  endDate                 DateTime?                @map("end_date") @db.Date
  deletedAt               DateTime?                @map("deleted_at")
  createdAt               DateTime?                @default(now()) @map("created_at")
  updatedAt               DateTime?                @default(now()) @updatedAt @map("updated_at")
  allocations             GrantAllocation[]
  milestones              GrantMilestone[]
  partnership             Partnership              @relation(fields: [partnershipId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transactions            Transaction[]
  utilizationCertificates UtilizationCertificate[]

  @@map("grants")
}

model GrantAllocation {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  grantId         String         @map("grant_id") @db.Uuid
  projectId       String?        @map("project_id") @db.Uuid
  causeId         String?        @map("cause_id") @db.Uuid
  allocatedAmount Decimal        @map("allocated_amount") @db.Decimal
  createdAt       DateTime?      @default(now()) @map("created_at")
