generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [ltree, pgvector(map: "vector"), uuid_ossp(map: "uuid-ossp")]
}

// =====================================================
// ENUMS
// =====================================================

enum ContentType {
  sutra
  translation
  commentary
  purport
  title
  subtitle
  colophon

  @@map("content_type_enum")
}

enum Language {
  sa
  en
  hi
  bn
  ta
  or
  mr
  gu

  @@map("language_enum")
}

enum Script {
  devanagari
  latin
  bengali
  tamil
  oriya

  @@map("script_enum")
}

enum Gender {
  male
  female
  @@map("gender_enum")
}

enum AgeGroup {
  child_0_5
  child_5_10
  teen_10_18
  youth_18_25
  adult_25_40
  mid_40_60
  senior_60_plus
  @@map("age_group_enum")
}

enum Purushartha {
  dharma
  artha
  kama
  moksha
  @@map("purushartha_enum")
}

enum InnerState {
  confused
  seeking
  stable
  disturbed
  detached
  @@map("inner_state_enum")
}

enum Svabhava {
  intellectual
  administrative
  creative
  practical
  @@map("svabhava_enum")
}

enum LifeStage {
  student
  unmarried
  married
  parent
  vanaprastha
  renunciate

  @@map("life_stage_enum")
}

enum GuidanceLevel {
  beginner
  intermediate
  advanced
  teacher

  @@map("guidance_level_enum")
}

enum UserRole {
  student
  mentor
  teacher
  coordinator
  admin
  donor
  director
  village_member
  city_member
  outreach_lead

  @@map("user_role_enum")
}

enum AssignmentType {
  mentor
  teacher
  coordinator

  @@map("assignment_type_enum")
}

enum RelationshipType {
  pitara
  matara
  sapinda
  vaivahika
  shishya
  guru
  prapautra
  pautra
  sahodara

  @@map("relationship_type_enum")
}

enum AuthorityStatus {
  guardian
  dependant
  karta
  shakha_head

  @@map("authority_status_enum")
}

// =====================================================
// CORE MODELS
// =====================================================

model Shastra {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug          String   @unique
  name          String
  structureType String   @map("structure_type")
  createdAt     DateTime @default(now()) @map("created_at")
  nodes         Node[]

  @@map("shastras")
}

model Source {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String
  role        String?
  description String?
  yearApprox  Int?     @map("year_approx")
  era         String?
  createdAt   DateTime @default(now()) @map("created_at")
  texts       Text[]
  versions    TextVersion[]

  @@map("sources")
}

model Node {
  id           String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  shastraId    String               @map("shastra_id") @db.Uuid
  parentId     String?              @map("parent_id") @db.Uuid
  level        String               // category, text, section, chapter, verse
  slug         String?
  sensitivity  Int                  @default(1) // 1: Universal, 2: Contextual, 3: Controlled
  minAge       Int?                 @map("min_age")
  orderIndex   Int                  @default(0) @map("order_index")
  canonicalRef String?              @map("canonical_ref")
  path         Unsupported("ltree")?
  deletedAt    DateTime?            @map("deleted_at")
  createdAt    DateTime             @default(now()) @map("created_at")

  shastra      Shastra              @relation(fields: [shastraId], references: [id], onDelete: Cascade)
  parent       Node?                @relation("NodeToNode", fields: [parentId], references: [id], onDelete: Cascade)
  children     Node[]               @relation("NodeToNode")
  texts        Text[]
  fromRelations NodeRelation[]      @relation("FromNode")
  toRelations   NodeRelation[]      @relation("ToNode")
  tags         NodeTag[]
  accessRules  ContentAccessRule[]
  stepInCurves LearningCurveStep[]
  userProgress UserNodeProgress[]
  bookmarks    Bookmark[]

  @@index([path], type: Gist)
  @@map("nodes")
}

model Text {
  id           String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nodeId       String         @map("node_id") @db.Uuid
  contentType  ContentType    @map("content_type")
  language     Language
  script       Script
  content      String
  sourceId     String?        @map("source_id") @db.Uuid
  isPrimary    Boolean        @default(false) @map("is_primary")
  anchorWord   String?        @map("anchor_word")
  segmentOrder Int?           @map("segment_order")
  deletedAt    DateTime?      @map("deleted_at")
  createdAt    DateTime       @default(now()) @map("created_at")

  node         Node           @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  source       Source?        @relation(fields: [sourceId], references: [id])
  metadata     TextMetadata?
  synonyms     Synonym[]
  versions     TextVersion[]
  embedding    TextEmbedding?
  highlights   Highlight[]

  @@index([nodeId])
  @@index([nodeId, contentType, language])
  @@map("texts")
}

model TextMetadata {
  textId         String          @id @map("text_id") @db.Uuid
  lifeStages     LifeStage[]     @map("life_stages")
  guidanceLevels GuidanceLevel[] @map("guidance_levels")
  isSensitive    Boolean         @default(false) @map("is_sensitive")

  text           Text            @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@map("text_metadata")
}

model Synonym {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  textId     String    @map("text_id") @db.Uuid
  word       String
  meaning    String?
  language   Language?
  orderIndex Int?      @map("order_index")

  text       Text      @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@map("synonyms")
}

model Tag {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug        String    @unique // Added slug for structured IDs like DOMESTIC_DYNAMICS
  name        String?   // title
  description String?
  keywords    String[]
  type        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  nodes       NodeTag[]
  
  // For hierarchical tags (tags/subtags)
  parentId    String?   @map("parent_id") @db.Uuid
  parent      Tag?      @relation("TagToTag", fields: [parentId], references: [id])
  subtags     Tag[]     @relation("TagToTag")
  
  // Sanskrit name for subtags
  sanskritName String?  @map("sanskrit_name")

  @@map("tags")
}

model NodeTag {
  nodeId String @map("node_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([nodeId, tagId])
  @@map("node_tags")
}

model NodeRelation {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  fromNodeId   String   @map("from_node_id") @db.Uuid
  toNodeId     String   @map("to_node_id") @db.Uuid
  relationType String?  @map("relation_type")
  createdAt    DateTime @default(now()) @map("created_at")

  fromNode     Node     @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode       Node     @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@map("node_relations")
}

model SubscriptionTier {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String          // e.g. "Gita Seeker", "Dharma Practitioner"
  description    String?
  level          Int             @default(1)
  
  users          User[]
  campaigns      CommunicationCampaign[]
  
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("subscription_tiers")
}

model CommunicationCampaign {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title          String
  content        String          @db.Text
  type           String          // EMAIL, SMS, WHATSAPP, PORTAL_NOTICE
  status         String          @default("draft") // draft, scheduled, sent
  
  targetTierId   String?         @map("target_tier_id") @db.Uuid
  targetTier     SubscriptionTier? @relation(fields: [targetTierId], references: [id])
  
  language       Language?
  scheduledAt    DateTime?       @map("scheduled_at")
  sentAt         DateTime?       @map("sent_at")
  
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("communication_campaigns")
}

model Organization {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name           String
  type           String          // Trust, NGO, Section 8, Pvt Ltd
  registrationNo String?         @map("registration_no")
  pan            String?
  tan            String?
  address        String?         @db.Text
  
  members        OrgMember[]
  legalDocuments LegalDocument[]
  compliances    ComplianceRecord[]
  projects       Project[]
  
  financialAccounts     FinancialAccount[]
  transactions          Transaction[]
  contributions         Contribution[]
  activityLogs          ActivityLog[]
  subscriptionTiers     SubscriptionTier[]
  campaigns             CommunicationCampaign[]
  
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("organizations")
}

model OrgMember {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  role           String          // Director, Trustee, Accountant, Advisor
  startDate      DateTime?       @map("start_date")
  endDate        DateTime?       @map("end_date")
  
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("org_members")
}

model LegalDocument {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  title          String
  category       String          // Registration, Tax, Financial, Regulatory
  fileUrl        String          @map("file_url")
  issuingAuthority String?       @map("issuing_authority")
  issueDate      DateTime?       @map("issue_date")
  expiryDate     DateTime?       @map("expiry_date")
  sensitivity    String          @default("RESTRICTED") // PUBLIC, ROLE_BASED, RESTRICTED
  
  status         String          @default("VALID") // VALID, EXPIRED, PENDING
  
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("legal_documents")
}

model ComplianceRecord {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  name           String
  type           String          // Tax, Financial, Regulatory, Internal
  frequency      String          // Monthly, Yearly, One-time
  dueDate        DateTime        @map("due_date")
  status         String          @default("UPCOMING") // UPCOMING, COMPLETED, OVERDUE, DELAYED
  
  responsibleId  String?         @map("responsible_id") @db.Uuid
  responsible    User?           @relation("ResponsibleUser", fields: [responsibleId], references: [id])
  
  supervisorId   String?         @map("supervisor_id") @db.Uuid
  supervisor     User?           @relation("SupervisorUser", fields: [supervisorId], references: [id])
  
  notes          String?         @db.Text
  
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("compliance_records")
}

model SecureShareLink {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  token          String          @unique
  purpose        String?         // CSR Partner, Auditor, Govt
  expiresAt      DateTime        @map("expires_at")
  accessCount    Int             @default(0) @map("access_count")
  
  documentIds    String[]        @map("document_ids") // List of LegalDocument IDs
  
  createdAt      DateTime        @default(now()) @map("created_at")

  @@map("secure_share_links")
}

model FinancialAccount {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String          // e.g. "SBI Main Account", "Petty Cash Box"
  type           String          // BANK, CASH, WALLET
  balance        Decimal         @default(0)
  currency       String          @default("INR")
  
  outgoingTransactions Transaction[] @relation("SourceAccount")
  incomingTransactions Transaction[] @relation("DestinationAccount")
  
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("financial_accounts")
}

model Transaction {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  amount         Decimal
  type           String          // INCOME, EXPENSE, TRANSFER
  date           DateTime        @default(now())
  
  sourceAccountId String?        @map("source_account_id") @db.Uuid
  sourceAccount   FinancialAccount? @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  
  destinationAccountId String?   @map("destination_account_id") @db.Uuid
  destinationAccount FinancialAccount? @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  
  category       String          // Food, Travel, Salary, Construction
  purpose        String          @db.Text
  programId      String?         @map("program_id") @db.Uuid
  program        Project?        @relation(fields: [programId], references: [id])
  
  paymentMethod  String          // UPI, CASH, BANK_TRANSFER
  proofUrl       String?         @map("proof_url") // Bill/Receipt scan
  
  recordedById   String          @map("recorded_by_id") @db.Uuid
  recordedBy     User            @relation("RecordedBy", fields: [recordedById], references: [id])
  
  approvedById   String?         @map("approved_by_id") @db.Uuid
  approvedBy     User?           @relation("ApprovedBy", fields: [approvedById], references: [id])
  
  status         String          @default("PENDING") // PENDING, APPROVED, EXECUTED, REJECTED
  
  auditLogs      AuditLog[]

  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("transactions")
}

model AuditLog {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  transactionId  String?         @map("transaction_id") @db.Uuid
  transaction    Transaction?    @relation(fields: [transactionId], references: [id])
  
  action         String          // CREATE, UPDATE, DELETE, APPROVE
  performedById  String          @map("performed_by_id") @db.Uuid
  performedBy    User            @relation(fields: [performedById], references: [id])
  
  oldData        Json?           @map("old_data")
  newData        Json?           @map("new_data")
  
  timestamp      DateTime        @default(now())

  @@map("audit_logs")
}

model Contribution {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId         String          @map("user_id") @db.Uuid
  user           User            @relation(fields: [userId], references: [id])
  amount         Decimal?
  type           String          // Cash, Online, In-Kind-Value
  item           String?         // For In-Kind (e.g. Rice, Clothes)
  quantity       Decimal?        
  unit           String?         // kg, pcs, sets
  purpose        String?
  projectId      String?         @map("project_id") @db.Uuid
  project        Project?        @relation(fields: [projectId], references: [id])
  date           DateTime        @default(now())
  
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("contributions")
}

model Project {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  totalBudget    Decimal         @map("total_budget")
  status         String          @default("active")
  
  contributions  Contribution[]
  expenses       Expense[]
  activityLogs   ActivityLog[]
  transactions   Transaction[]
  
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("projects")
}

model Expense {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId      String          @map("project_id") @db.Uuid
  project        Project         @relation(fields: [projectId], references: [id])
  amount         Decimal
  category       String
  description    String
  date           DateTime        @default(now())
  
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("expenses")
}

model ActivityLog {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title          String
  description    String
  category       String
  date           DateTime        @default(now())
  images         String[]        @default([])
  
  projectId      String?         @map("project_id") @db.Uuid
  project        Project?        @relation(fields: [projectId], references: [id])
  
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("activity_logs")
}

model TextVersion {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  textId        String      @map("text_id") @db.Uuid
  content       String?
  contentType   ContentType? @map("content_type")
  language      Language?
  script        Script?
  sourceId      String?     @map("source_id") @db.Uuid
  versionNumber Int?        @map("version_number")
  updatedBy     String?     @map("updated_by")
  createdAt     DateTime    @default(now()) @map("created_at")

  text          Text        @relation(fields: [textId], references: [id], onDelete: Cascade)
  source        Source?     @relation(fields: [sourceId], references: [id])

  @@map("text_versions")
}

model TextEmbedding {
  textId    String                   @id @map("text_id") @db.Uuid
  embedding Unsupported("vector(384)")
  model     String
  createdAt DateTime                 @default(now()) @map("created_at")

  text      Text                     @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@map("text_embeddings")
}

// =====================================================
// USER & GUIDANCE LAYER
// =====================================================

model User {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email          String          @unique
  // Identity & Contact
  full_name      String?         @map("full_name")
  phoneNumber    String?         @map("phone_number")
  whatsappNumber String?         @map("whatsapp_number")
  alternatePhone String?         @map("alternate_phone")
  emergencyContact String?       @map("emergency_contact")
  avatarUrl      String?         @map("avatar_url")
  
  // Personal Attributes
  gender         Gender?
  dateOfBirth    DateTime?       @map("date_of_birth")
  maritalStatus  String?         @map("marital_status")
  education      String?
  occupation     String?
  skills         String[]        @default([])
  interests      String[]        @default([])
  nativePlace    String?         @map("native_place")
  
  isOnline       Boolean         @default(true) @map("is_online")
  emailVerified  DateTime?       @map("email_verified")
  verificationToken String?      @map("verification_token")
  resetToken     String?         @map("reset_token")
  resetTokenExpires DateTime?    @map("reset_token_expires")
  roles          UserRole[]      @default([student])
  ageGroup       AgeGroup?       @map("age_group")
  lifeStage      LifeStage?      @map("life_stage")
  eligibilityLevel Int             @default(1) @map("eligibility_level")
  primaryFocus   Purushartha?    @map("primary_focus")
  innerState     InnerState?     @map("inner_state")
  nature         Svabhava?
  
  // Exhaustive Geography
  addressLine1   String?         @map("address_line1")
  addressLine2   String?         @map("address_line2")
  village        String?
  city           String?
  state          String?
  pinCode        String?         @map("pin_code")
  
  // Institutional Context
  notes          String?         @db.Text
  metadata       Json?           @default("{}")
  journeyStageId String?         @map("journey_stage_id") @db.Uuid
  journeyStage   LifeJourneyStage? @relation(fields: [journeyStageId], references: [id])
  subscriptionTierId String?     @map("subscription_tier_id") @db.Uuid
  subscriptionTier SubscriptionTier? @relation(fields: [subscriptionTierId], references: [id])
  
  notificationPrefs Json?        @default("{\"email\": true, \"whatsapp\": false, \"sms\": false}")
  
  createdAt      DateTime        @default(now()) @map("created_at")
  lastActive     DateTime?       @map("last_active")
  
  statistics     UserStatistics?
  bookmarks      Bookmark[]
  highlights     Highlight[]
  nodeProgress   UserNodeProgress[]
  curveProgress  UserCurveProgress[]
  
  // Relations
  contributions  Contribution[]
  benefits       Benefit[]
  familyLinks    FamilyLink[]    @relation("UserMain")
  relatedTo      FamilyLink[]    @relation("UserRelated")
  
  assignmentsAsGuide   GuidanceAssignment[] @relation("Guide")
  assignmentsAsStudent GuidanceAssignment[] @relation("Student")

  orgMemberships       OrgMember[]
  responsibleCompliances ComplianceRecord[] @relation("ResponsibleUser")
  supervisedCompliances  ComplianceRecord[] @relation("SupervisorUser")

  recordedTransactions   Transaction[] @relation("RecordedBy")
  approvedTransactions   Transaction[] @relation("ApprovedBy")
  auditActions           AuditLog[]

  circleMemberships    CircleMember[]
  circlePosts          CirclePost[]
  mentoredCircles      Circle[]           @relation("CircleMentor")
  hostedEvents         VedicEvent[]       @relation("EventHost")
  eventRegistrations   EventRegistration[]

  @@map("users")
}


model Benefit {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  type        String   // SCHOLARSHIP, FOOD, BOOKS, COUNSELING
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("benefits")
}

model FamilyLink {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  relatedId   String           @map("related_id") @db.Uuid
  type        RelationshipType
  notes       String?
  createdAt   DateTime         @default(now()) @map("created_at")

  user        User             @relation("UserMain", fields: [userId], references: [id], onDelete: Cascade)
  related     User             @relation("UserRelated", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([userId, relatedId, type])
  @@map("family_links")
}

model LifeJourneyStage {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  stageNumber Int      @unique @map("stage_number")
  slug        String   @unique
  name        String
  category    String   // e.g., "Childhood", "Householder"
  minAge      Int?     @map("min_age")
  maxAge      Int?     @map("max_age")
  authority   String?
  focus       String?
  dominantPurushartha Purushartha @map("dominant_purushartha")
  
  description String?
  keyProblems String[] @map("key_problems")
  
  users       User[]
  
  @@map("life_journey_stages")
}


model UserStatistics {
  userId             String   @id @map("user_id") @db.Uuid
  nodesReadCount     Int      @default(0) @map("nodes_read_count")
  coursesCompleted   Int      @default(0) @map("courses_completed")
  contributionPoints Int      @default(0) @map("contribution_points")
  updatedAt          DateTime @default(now()) @map("updated_at")

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_statistics")
}

model GuidanceAssignment {
  id             String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  guideId        String         @map("guide_id") @db.Uuid
  studentId      String         @map("student_id") @db.Uuid
  assignmentType AssignmentType @map("assignment_type")
  subject        String?
  status         String         @default("active")
  createdAt      DateTime       @default(now()) @map("created_at")

  guide          User           @relation("Guide", fields: [guideId], references: [id], onDelete: Cascade)
  student        User           @relation("Student", fields: [studentId], references: [id], onDelete: Cascade)
  sessions       GuidanceSession[]

  @@unique([guideId, studentId, assignmentType])
  @@map("guidance_assignments")
}

model GuidanceSession {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  assignmentId  String   @map("assignment_id") @db.Uuid
  topic         String?
  summaryNotes  String?  @map("summary_notes")
  sessionDate   DateTime @default(now()) @map("session_date")
  durationMins  Int?     @map("duration_minutes")

  assignment    GuidanceAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("guidance_sessions")
}

model LearningCurve {
  id               String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title            String
  description      String?
  targetLifeStages LifeStage[]         @map("target_life_stages")
  isPublished      Boolean             @default(false) @map("is_published")
  createdAt        DateTime            @default(now()) @map("created_at")
  steps            LearningCurveStep[]
  userProgress     UserCurveProgress[]

  @@map("learning_curves")
}

model LearningCurveStep {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  curveId          String   @map("curve_id") @db.Uuid
  stepOrder        Int      @map("step_order")
  title            String
  nodeId           String?  @map("node_id") @db.Uuid
  unlockRequirement Json?    @map("unlock_requirement")
  createdAt        DateTime @default(now()) @map("created_at")

  curve            LearningCurve @relation(fields: [curveId], references: [id], onDelete: Cascade)
  node             Node?         @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  userProgress     UserCurveProgress[]

  @@unique([curveId, stepOrder])
  @@map("learning_curve_steps")
}

model UserCurveProgress {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  curveId       String   @map("curve_id") @db.Uuid
  currentStepId String?  @map("current_step_id") @db.Uuid
  isCompleted   Boolean  @default(false) @map("is_completed")
  startedAt     DateTime @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  curve         LearningCurve     @relation(fields: [curveId], references: [id], onDelete: Cascade)
  currentStep   LearningCurveStep? @relation(fields: [currentStepId], references: [id])

  @@unique([userId, curveId])
  @@map("user_curve_progress")
}

model UserNodeProgress {
  userId       String   @map("user_id") @db.Uuid
  nodeId       String   @map("node_id") @db.Uuid
  isRead       Boolean  @default(false) @map("is_read")
  lastAccessed DateTime @default(now()) @map("last_accessed")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  node         Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([userId, nodeId])
  @@map("user_node_progress")
}

model Bookmark {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  nodeId     String   @map("node_id") @db.Uuid
  folderName String   @default("Main") @map("folder_name")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  node       Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@map("bookmarks")
}

model Highlight {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  textId         String   @map("text_id") @db.Uuid
  selectionRange String?  @map("selection_range") // Prisma doesn't support int4range natively, using string or json
  note           String?
  colorCode      String?  @map("color_code")
  createdAt      DateTime @default(now()) @map("created_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text           Text     @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@map("highlights")
}

// =====================================================
// COMMUNITY & SOCIAL LAYER
// =====================================================

model Circle {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String
  slug          String          @unique
  description   String?
  avatar        String?
  type          CircleType      @default(REGIONAL)
  location      String?
  memberCount   Int             @default(0) @map("member_count")
  mentorId      String?         @map("mentor_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  
  mentor        User?           @relation("CircleMentor", fields: [mentorId], references: [id])
  members       CircleMember[]
  posts         CirclePost[]

  @@map("circles")
}

enum CircleType {
  REGIONAL
  STUDY_GROUP
  MENTOR_CIRCLE

  @@map("circle_type_enum")
}

model CircleMember {
  userId    String     @map("user_id") @db.Uuid
  circleId  String     @map("circle_id") @db.Uuid
  role      CircleRole @default(MEMBER)
  joinedAt  DateTime   @default(now()) @map("joined_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle    Circle     @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@id([userId, circleId])
  @@map("circle_members")
}

enum CircleRole {
  MEMBER
  MODERATOR
  MENTOR

  @@map("circle_role_enum")
}

model CirclePost {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  circleId  String   @map("circle_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String
  category  PostCategory @default(REALIZATION)
  likes     Int      @default(0)
  replies   Int      @default(0)
  isPinned  Boolean  @default(false) @map("is_pinned")
  createdAt DateTime @default(now()) @map("created_at")

  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("circle_posts")
}

enum PostCategory {
  REALIZATION
  QUESTION
  ANNOUNCEMENT

  @@map("post_category_enum")
}

// =====================================================
// EVENTS LAYER
// =====================================================

model VedicEvent {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String
  description String?
  hostId      String      @map("host_id") @db.Uuid
  startTime   DateTime    @map("start_time")
  endTime     DateTime    @map("end_time")
  type        EventType   @default(LIVE_SATSANG)
  category    String?
  platform    String      @default("ZOOM")
  link        String?
  createdAt   DateTime    @default(now()) @map("created_at")

  host        User        @relation("EventHost", fields: [hostId], references: [id])
  registrations EventRegistration[]

  @@map("vedic_events")
}

enum EventType {
  LIVE_SATSANG
  WORKSHOP
  GROUP_MEDITATION

  @@map("event_type_enum")
}

model EventRegistration {
  userId    String   @map("user_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     VedicEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@map("event_registrations")
}

// =====================================================
// ACCESS & CONTENT RULES (ALREADY PRESENT BUT LINKED)
// =====================================================

model ContentAccessRule {
  id                   String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nodeId               String          @map("node_id") @db.Uuid
  allowedRoles         UserRole[]      @map("allowed_roles")
  allowedLifeStages    LifeStage[]     @map("allowed_life_stages")
  allowedGuidanceLevels GuidanceLevel[] @map("allowed_guidance_levels")
  isRestricted         Boolean         @default(true) @map("is_restricted")
  messageIfLocked      String?         @map("message_if_locked")

  node                 Node            @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@map("content_access_rules")
}
