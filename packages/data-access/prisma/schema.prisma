}

model partner_organizations {
  id                      String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                    String
  type                    partner_type_enum
  registration_number     String?
  pan                     String?
  tan                     String?
  contact_person          String?
